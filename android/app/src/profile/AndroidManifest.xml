<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <!-- Profiling only: the engine falls back to OpenGLES on this device
             even though Vulkan 1.1 is available, and Vulkan measured ~40%
             faster Flutter-side rasterisation. Kept out of main so release
             keeps the engine's own driver selection. -->
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="vulkan" />
    </application>
</manifest>
